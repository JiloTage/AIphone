{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voice-chat-example",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "observability": { "enabled": true }
}
