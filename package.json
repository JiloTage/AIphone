{
  "name": "aiphone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787",
    "test": "node --test tests/*.test.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --config wrangler.local.jsonc",
    "deploy:voice": "uv run --env-file .env.deploy modal deploy backend/modal_app.py"
  },
  "devDependencies": {
    "wrangler": "4.160.0"
  }
}
